# Rapid24.ai — local secrets (do not commit)
# Copy to .env.local and fill in values.

# Required for real LLM chat (preferred)
OPENAI_API_KEY=

# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: use Gemini instead of OpenAI
# ASSISTANT_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Provider selection: auto | openai | gemini | mock
# auto = OpenAI if key present, else Gemini if key present, else mock
ASSISTANT_PROVIDER=auto

# ─── GitHub OAuth (Auth.js / NextAuth) ───────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Auth.js v5 also accepts AUTH_SECRET / AUTH_URL as aliases
AUTH_SECRET=
AUTH_URL=http://localhost:3000
